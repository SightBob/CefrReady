# ─── Database (Neon - free PostgreSQL) ───────────────────────────────────────
# สมัครที่ https://neon.tech → copy connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/cefr_ready?sslmode=require"

# ─── Authentication ───────────────────────────────────────────────────────────
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-secret"

# สร้างด้วย: openssl rand -base64 32
# SECURITY: ต้องเป็น random string อย่างน้อย 32 ตัวอักษร (production จะ refuse boot ถ้าสั้นกว่านี้)
# ห้ามใช้ค่าที่คาดเดาได้ เช่น ชื่อเว็บ/ชื่อโปรเจค — ใครก็ตามที่รู้ค่านี้ forge JWT session เป็น admin ได้ทันที
NEXTAUTH_SECRET="your-random-secret-here"

# URL ของเว็บ (ไม่มี trailing slash)
# SECURITY: ต้องตรงกับ redirect URL ใน Google OAuth console — ใช้ https:// ใน production เสมอ
NEXTAUTH_URL="https://cefr-ready.site"

# ─── Cloudflare R2 (free audio storage) ──────────────────────────────────────
# สมัครที่ https://dash.cloudflare.com → R2 → Create bucket
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="cefr-ready-audio"
# เปิด Public access บน R2 bucket แล้ว copy URL
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxx.r2.dev"

# ─── Upstash Redis (rate limiting) ─────────────────────────────────────────────
# สมัครที่ https://upstash.com → Create Redis database (free tier)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Admin Access ──────────────────────────────────────────────────────────────
# Email address of the admin user (must match Google OAuth email)
ADMIN_EMAIL="your-admin-email@gmail.com"

# ─── Sentry (Error Tracking) ──────────────────────────────────────────────────
# สมัครที่ https://sentry.io → Create project → Copy DSN
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="cefr-ready"

# ─── Dev tunnel (optional) ────────────────────────────────────────────────────
# ใส่เฉพาะตอน dev ผ่าน ngrok/tunnel — ใช้ .env.local เท่านั้น ห้าม commit domain จริง
# NGROK_ORIGIN="your-name.ngrok-free.dev"

# ─── AI Tutor (โหมด AI ในหน้าทำข้อสอบ — Figma 580:27829) ─────────────────────
# เปิด/ปิดฟีเจอร์ทั้งหมด (ไม่ตั้ง = ปิดทุกคน) + สิทธิ์รายบัญชีในตาราง users
# (คอลัมน์ users.ai_tutor_access — migration 0045) + rollout % ตาม hash ของ user id
AI_TUTOR_ENABLED="false"
# AI_TUTOR_ROLLOUT_PERCENT="0"

# secret สำหรับลงชื่อ proof "ผู้เรียนตอบข้อนี้แล้ว" (HMAC) — ใช้ของตัวเอง ห้ามใช้ซ้ำกับ
# NEXTAUTH_SECRET และห้าม commit: สร้างด้วย: openssl rand -base64 32
AI_TUTOR_PROOF_SECRET=""

# โมเดล + key ของ OpenRouter (ใช้ตัวเดียวกับ Tap & Select)
OPENROUTER_API_KEY="sk-or-v1-your-key"
# โมเดลหลัก + โมเดลสำรอง (สลับอัตโนมัติเมื่อหลักล้มเหลวก่อนมีเนื้อหาตอบ)
AI_TUTOR_MODEL="minimax/minimax-m3.1-flash:free"
AI_TUTOR_FALLBACK_MODEL="deepseek/deepseek-v4.1-flash"

# reasoning: ระดับความคิดของโมเดล (none = ปิด · low/medium/high = จำกัด)
# หมายเหตุ: minimax บังคับให้คิดเสมอ (ปิดไม่ได้) จึงใช้ effort ต่ำแทน
# deepseek ปิดได้ (mandatory: false) — ตั้งเป็น none ได้ถ้าอยากได้คำตอบไวเร็ว
AI_TUTOR_REASONING_EFFORT="low"
AI_TUTOR_FALLBACK_REASONING_EFFORT="none"

# โควตา: ต่อ (ผู้เรียน, ข้อ) ต่อวันตามเวลาไทย / เพดานซ่อนต่อผู้เรียนต่อวัน /
# เพดานรวมทั้งระบบต่อวัน (kill switch — ไม่ตั้ง = ไม่จำกัด)
AI_TUTOR_QUESTION_QUOTA="5"
AI_TUTOR_USER_DAILY_LIMIT="50"
# AI_TUTOR_SYSTEM_DAILY_LIMIT="500"

# เพดาน token รวม (reasoning + คำตอบ ~120 คำไทย) + เวลารอสูงสุดต่อครั้ง
# + เวลาที่ยอมรอ "เนื้อหาชิ้นแรก" (ถ้าเกินจะสลับไปใช้โมเดลสำรอง)
AI_TUTOR_MAX_TOKENS="1200"
AI_TUTOR_TIMEOUT_MS="30000"
AI_TUTOR_FIRST_TOKEN_TIMEOUT_MS="12000"
# AI_TUTOR_PROMPT_CACHE="1"

# ─── เครื่องมือเทียบโมเดล (scripts/ai-tutor-eval.ts) ─────────────────────────
# ใช้ตอนพัฒนาเท่านั้น — ยิงโมเดลจริง ห้ามรันใน vitest
# AI_TUTOR_EVAL_MODELS="minimax/minimax-m3.1-flash:free,deepseek/deepseek-v4.1-flash"
# AI_TUTOR_EVAL_MAX_CALLS="45"
