{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cefr-ready-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // AI Tutor retention (เดิม vercel.json cron) — worker.mjs มี `scheduled` handler
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // ตั้งค่าผ่าน `wrangler secret put` / dashboard ไม่ใส่ในไฟล์
  // DATABASE_URL, NEXTAUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // UPSTASH_*, NEXT_PUBLIC_POSTHOG_KEY, R2_*
  "vars": {
    "NEXTAUTH_URL": "https://cefr-ready.site",
    "AUTH_TRUST_HOST": "true",
    "NODE_ENV": "production"
  }
}
